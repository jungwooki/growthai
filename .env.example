OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# AWS Lambda execution role only; no long-lived AWS keys.
MEDIA_AWS_RUNTIME_ROLE=
# s3 enables durable app-wide estimated AI cost tracking.
BUDGET_STORAGE=
BUDGET_MONTHLY_KRW=50000
BUDGET_OVERHEAD_KRW=10000
# Planning assumptions, not a live FX rate or invoice tax calculation.
BUDGET_USD_KRW=1500
BUDGET_TAX_MULTIPLIER=1.10
# Hosting only: use secrets in the hosting dashboard, never commit .env.
APP_ENV=local
ALLOWED_HOSTS=
APP_USERNAME=
APP_PASSWORD=

# Optional private direct uploads. Empty keeps the existing server upload path.
MEDIA_STORAGE=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-southeast-2
# Production: scoped Vercel OIDC role. No long-lived AWS keys required.
MEDIA_AWS_ROLE_ARN=
# Local only: requires boto3[crt] for browser-based aws login.
MEDIA_AWS_PROFILE=
# Legacy key-based deployments only; leave empty for OIDC/profile modes.
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
# Independent random secret of at least 32 characters; never a login password.
MEDIA_SIGNING_SECRET=

# MPS center mode: generate securely with scripts/configure_centers.py.
# When enabled, legacy shared APP_USERNAME/APP_PASSWORD login is disabled.
APP_CENTER_AUTH_JSON=
APP_SESSION_SECRET=
